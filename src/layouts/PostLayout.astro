---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Giscus from '../components/Giscus.astro';

interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const { title, categories, tags } = post.data;
const { Content } = await render(post);
---

<BaseLayout title={title}>
  <article class="post">
    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      <div class="post-meta">
        <time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10)}</time>
        {categories.length > 0 && (
          <span class="meta-group">
            {categories.map((c) => (
              <a class="meta-link" href={`/categories/${encodeURIComponent(c)}/`}>
                {c}
              </a>
            ))}
          </span>
        )}
        {tags.length > 0 && (
          <span class="meta-group">
            {tags.map((t) => (
              <a class="meta-link tag" href={`/tags/${encodeURIComponent(t)}/`}>
                #{t}
              </a>
            ))}
          </span>
        )}
      </div>
    </header>
    <div class="post-body">
      <Content />
    </div>
    <Giscus />
  </article>
</BaseLayout>
