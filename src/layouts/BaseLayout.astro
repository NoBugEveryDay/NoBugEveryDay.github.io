---
import { site, nav, mascot } from '../config';
import '../styles/global.css';
import Search from '../components/Search.astro';

interface Props {
  title?: string;
  description?: string;
  /** hidden 页面为 true：不索引、不加载评论与搜索 */
  hidden?: boolean;
}
const { title, description = site.description, hidden = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.title}` : site.title;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {hidden && <meta name="robots" content="noindex, nofollow" />}
    <title>{pageTitle}</title>
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body data-pagefind-ignore={hidden ? 'all' : undefined}>
    <header class="site-header">
      <a class="site-title" href="/">{site.title}</a>
      <nav>
        {
          nav.map((item) => (
            <a href={item.href} class="nav-link" aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>
    {!hidden && <Search />}
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        © {new Date().getFullYear()} {site.author} · 由 Astro 构建，GitHub Actions 自动部署 ·
        <a href="https://github.com/NoBugEveryDay/NoBugEveryDay.github.io">源码</a> ·
        <a href="/rss.xml">RSS</a>
      </p>
      {!hidden && mascot.enabled && (
        <p class="mascot-credit">
          看板娘·鲸鱼娘：<a href="https://github.com/Sutera-Diffusus/dsh-whale-musume" rel="noopener">dsh-whale-musume</a>
          （MIT © Sutera-Diffusus，立绘由 <a href="https://github.com/SuteraWu" rel="noopener">SuteraWu</a> 绘制）
        </p>
      )}
    </footer>
    {
      !hidden && mascot.enabled && (
        <>
          <link rel="stylesheet" href="/assets/dsh-whale-moe.css" />
          <script is:inline>window.__BLOG_NO_REST_PRELOAD__ = true;</script>
          <script defer src="/assets/whale-moe-core.js"></script>
          <script defer src="/assets/dsh-whale-moe.js"></script>
        </>
      )
    }
  </body>
</html>
